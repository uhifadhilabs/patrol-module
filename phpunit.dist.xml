<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnWarning="true">
    <php>
        <!--
            The suite states the memory it needs rather than inheriting whatever
            a developer's php.ini happens to say. Every functional test boots a
            kernel with debug=true — which is what makes the container
            self-invalidate — and a debug kernel collects every query of every
            request, so one process running the whole suite accumulates. A suite
            that passes on one machine and dies on another over an ini nobody set
            is a worse signal than no signal.
        -->
        <ini name="memory_limit" value="-1"/>
        <env name="KERNEL_CLASS" value="Uhifadhi\Patrol\Tests\Integration\TestKernel"/>
        <!-- Real PostGIS for integration tests (fundi-postgis-test container). -->
        <env name="PATROL_TEST_DATABASE_URL"
             value="postgresql://app:app@127.0.0.1:5434/patrol_bundle_test?serverVersion=17&amp;charset=utf8"/>
    </php>
    <testsuites>
        <testsuite name="default">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <source restrictNotices="true" restrictWarnings="true">
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>