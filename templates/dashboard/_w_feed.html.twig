{# Widget "feed" — the patrol feed beside its mini-map (PL·07 + PL·08). Hovering
   a feed row spotlights that patrol's track on the map next to it, which is
   what the design's "hover a row to highlight" caption promises. #}
{% import '@UhifadhiPatrol/dashboard/_ui.html.twig' as ui %}
<div class="grid g32 patrol-flush">
    <div class="c" data-patrol-feed {{ stimulus_controller('@uhifadhi/patrol-module/rows') }}>
        <span class="tab">Patrol feed<span class="src">· latest first</span></span>
        {% for patrol in dashboard.patrols %}
            {# Discarded patrols read quietly here and are drawn on no map: the
               plate beside this feed is the coverage picture, and a discarded
               track is absent from its payload. Hovering the row therefore
               highlights nothing, which is the honest result. #}
            <div class="patrol-feed-row{{ patrol.discarded ? ' patrol-abandoned' }}" data-patrol="{{ patrol.uuid.toRfc4122 }}" data-patrol-type="{{ patrol.type }}" data-patrol-station="{{ patrol.station }}"
                 {{ stimulus_target('@uhifadhi/patrol-module/rows', 'row') }}
                 {{ stimulus_action('@uhifadhi/patrol-module/rows', 'hover', 'mouseenter') }}
                 {{ stimulus_action('@uhifadhi/patrol-module/rows', 'unhover', 'mouseleave') }}>
                <span class="patrol-avatar">{{ ui.initials(patrol.lead) }}</span>
                <span class="patrol-who">{{ patrol.ref }}<em>{{ patrol.station ?: '—' }} · {{ ui.lead_name(patrol.lead) }}</em></span>
                {{ ui.type_chip(patrol.type, types, typeColor) }}
                <span class="patrol-n">{{ ui.started(patrol) }} · {{ ui.distance(patrol) }}</span>
                {% if patrol.observations|length %}<span class="chip warn">{{ patrol.observations|length }} obs</span>{% endif %}
                {# One geometry throughout, as the design rules for the row: the
                   chip carries the state and nothing else does. The reason is
                   not repeated here — it lives on the register row and on the
                   detail page. #}
                {% if patrol.discarded %}
                    <span class="chip {{ patrol.held ? 'warn' : 'patrol-discard-pill' }}">{{ patrol.held ? 'held for review' : 'discarded' }}</span>
                {% endif %}
                <span class="patrol-spacer"></span>
                <a class="open-btn" href="{{ path('patrol_show', {uuid: area.uuid, patrol: patrol.uuid}) }}">Open →</a>
            </div>
        {% else %}
            <p class="patrol-empty">No patrols recorded yet.</p>
        {% endfor %}
        {% if dashboard.patrols|length %}
            <p class="patrol-empty patrol-hidden" {{ stimulus_target('@uhifadhi/patrol-module/rows', 'empty') }}>No patrols of that type this month.</p>
        {% endif %}
    </div>

    <div class="c">
        <span class="tab">Tracks<span class="src">· hover a row to highlight</span></span>
        {{ ui.viewer(coveragePayload, 'Patrol tracks') }}
        {{ ui.legend(types, typeColor) }}
    </div>
</div>