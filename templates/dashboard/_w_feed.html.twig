{# Widget "feed" — the patrol feed (PL·07), a single full-width card.

   THE BURIED SECOND MAP IS GONE (owner ruling 2026-09-08): the feed used to sit
   beside a second Tracks plate that drew the identical payload the coverage map
   (PL·05) already leads with. A map buried beside a feed is redundant with the
   one that leads below the KPIs, so the feed now takes the full width on its own.
   The row still carries its patrol id so a coverage map elsewhere on the page can
   still spotlight the track a row names. #}
{% import '@UhifadhiPatrol/dashboard/_ui.html.twig' as ui %}
{# Same overflow rule as the log: the feed is the LATEST few, not all of them,
   so the card stays a fixed size whatever the month's count. #}
{% set patrolFeedLimit = 8 %}
<div class="c" data-patrol-feed>
    <span class="tab">Patrol feed<span class="src">· latest first · {{ min(dashboard.patrols|length, patrolFeedLimit) }} of {{ dashboard.totalCount }}</span></span>
    {% for patrol in dashboard.patrols|slice(0, patrolFeedLimit) %}
        {# Discarded patrols read quietly here: the chip carries the state and
           nothing else does — the reason lives on the register row and the
           detail page. #}
        {# Hovering a row spotlights its track on any coverage plate on the
           page: the attribute names the layer its type is drawn in and the
           reference that layer identifies a feature by. #}
        <div class="patrol-feed-row{{ patrol.discarded ? ' patrol-abandoned' }}" data-patrol="{{ patrol.uuid.toRfc4122 }}"
             data-atlas-highlight="patrol.tracks.{{ patrol.type }}:{{ patrol.ref }}">
            <span class="patrol-avatar">{{ ui.initials(patrol.lead) }}</span>
            <span class="patrol-who">{{ patrol.ref }}<em>{{ patrol.station ?: '—' }} · {{ ui.lead_name(patrol.lead) }}</em></span>
            {{ ui.type_chip(patrol.type, types, typeColor) }}
            <span class="patrol-n">{{ ui.started(patrol) }} · {{ ui.distance(patrol) }}</span>
            {% if patrol.observations|length %}<span class="chip warn">{{ patrol.observations|length }} obs</span>{% endif %}
            {% if patrol.discarded %}
                <span class="chip {{ patrol.held ? 'warn' : 'patrol-discard-pill' }}">{{ patrol.held ? 'held for review' : 'discarded' }}</span>
            {% endif %}
            <span class="patrol-spacer"></span>
            <a class="open-btn" href="{{ path('patrol_show', {uuid: area.uuid, patrol: patrol.uuid}) }}">Open →</a>
        </div>
    {% else %}
        <p class="patrol-empty">{{ filter.isNarrowed ? 'No patrols match this filter.' : 'No patrols recorded yet.' }}</p>
    {% endfor %}
</div>
