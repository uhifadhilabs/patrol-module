{# Widget "cal" — the month calendar (PL·11).

   The card and its caption stay here; the month itself (header row + grid) is
   _cal_body.html.twig, which the ‹ › controls re-fetch from patrol_calendar and
   swap in. The dashboard ships the CURRENT month already rendered, so the widget
   is complete before any JavaScript runs. #}
<div class="c" data-patrol-calendar
     {{ stimulus_controller('@uhifadhilabs/patrol-module/calendar', {url: path('patrol_calendar', {uuid: area.uuid})}) }}>
    <span class="tab"><span class="idx">PL&middot;11</span>Patrol calendar<span class="src">&middot; <span
                {{ stimulus_target('@uhifadhilabs/patrol-module/calendar', 'label') }}>{{ now|date('F Y')|lower }}</span></span></span>
    <div {{ stimulus_target('@uhifadhilabs/patrol-module/calendar', 'body') }}>
        {{ include('@UhifadhiLabsPatrol/dashboard/_cal_body.html.twig', {cells: dashboard.calendar, month: now}) }}
    </div>
</div>