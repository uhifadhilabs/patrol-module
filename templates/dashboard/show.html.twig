{# The patrols module as a widget dashboard (settled design: the patrols screen,
   direction G "combined"). The dashboard itself stays CLEAN — no edit controls;
   all editing (add/remove, width, drag order) happens in the widget library
   reached via "Customize widgets".

   The widgets themselves live in _w_<id>.html.twig and are rendered by BOTH this
   screen and the library, so a preview can never drift from the real thing.
   Which widgets, how wide and in what order comes from the host widget framework resolving PatrolWidgets —
   the design's layout until this person changes it. #}
{% extends '@UhifadhiPatrol/base.html.twig' %}

{% block title %}{{ area.name }} — Patrols{% endblock %}

{% block patrol_page %}
<div class="crumb"><a href="{{ path('dashboard_index') }}">uhifadhi</a> / <a href="{{ path('dashboard_index') }}">areas</a> / <a href="{{ path('dashboard_area_show', {uuid: area.uuid}) }}">{{ area.name|lower }}</a> / <a href="{{ path('dashboard_area_modules_grid', {uuid: area.uuid}) }}">modules</a> / patrols</div>

<div class="pghead">
    <div>
        <h1 class="pg">{{ area.name }} — Patrols</h1>
        <p class="pgsub">Field patrol effort across the area — every track, observation and station at a glance.</p>
    </div>
    <div class="pgact patrol-pgact">
        {# The library edits ONE PERSON's layout, so the link exists only where the
           route does (a host running SecurityBundle — see the bundle class). #}
        {% if widgetScreens %}
            <a class="tgl patrol-act" href="{{ path('patrol_widgets', {uuid: area.uuid}) }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>Customize widgets</a>
        {% endif %}
        {# The two recording screens exist only where the host runs SecurityBundle
           (they enforce patrols.record — see UhifadhiPatrolBundle), so the
           links are rendered only when their routes do. #}
        {% if recordScreens %}
            <a class="tgl patrol-act" href="{{ path('patrol_import', {uuid: area.uuid}) }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m17 8-5-5-5 5"/><path d="M12 3v12"/></svg>Import GPX</a>
            <a class="cta" href="{{ path('patrol_log', {uuid: area.uuid}) }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>Log patrol</a>
        {% endif %}
    </div>
</div>

<a href="{{ path('dashboard_area_modules_grid', {uuid: area.uuid}) }}" class="backbtn"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>All modules</a>

<div class="patrol-wgrid">
    {% for widget in widgets %}
        {% if widget.on %}
            <div data-w="{{ widget.id }}" class="patrol-w{{ widget.cols }}">
                <div class="patrol-winner">
                    {{ include('@UhifadhiPatrol/dashboard/_w_' ~ widget.id ~ '.html.twig') }}
                </div>
            </div>
        {% endif %}
    {% endfor %}
</div>
{% endblock %}
