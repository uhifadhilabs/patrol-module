{# Widget "log" — the patrol log table (PL·06). #}
{% import '@UhifadhiPatrol/dashboard/_ui.html.twig' as ui %}
{# OVERFLOW RULE (owner: an overview card never grows with data). The register is
   the LATEST N, not all of them — the same latest-N idiom the design draws and the
   incidents register uses (slice + "latest N of M"), so a month of 140 patrols
   leaves this card the same height as a month of 8. The whole month is still on
   the map (every track) and the calendar (a pill per day); this card is the recent
   window onto it. #}
{% set patrolLogLimit = 8 %}
<div class="c" data-patrol-log>
    <span class="tab">Patrol log<span class="src">· patrol · latest {{ min(dashboard.patrols|length, patrolLogLimit) }} of {{ dashboard.totalCount }}</span></span>
    {{ ui.filters(dashboard, types, typeColor, now, area, filter) }}
    <table class="tbl">
        <thead>
            <tr>
                <th>id</th>
                <th>type</th>
                <th>station</th>
                <th>lead</th>
                <th>start</th>
                <th class="num">duration</th>
                <th class="num">distance</th>
                <th>observations</th>
                {# The settled discard design's web row puts the state and the
                   ranger's reason in a column of their own, and the purge date
                   "on the row, not buried". Ordinary patrols leave it empty:
                   "complete" is what a patrol in the register is, and pilling
                   every row to say so would make the discarded ones quieter,
                   not louder. #}
                <th>status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for patrol in dashboard.patrols|slice(0, patrolLogLimit) %}
            {# HOVERING A ROW SPOTLIGHTS ITS TRACK on the coverage plate. The
               attribute names the layer its own type is drawn in and the
               reference the layer identifies a feature by; the atlas wires the
               rest, so this module writes no JavaScript for it. #}
            <tr class="{{ patrol.discarded ? 'patrol-abandoned' }}" data-patrol="{{ patrol.uuid.toRfc4122 }}"
                data-atlas-highlight="patrol.tracks.{{ patrol.type }}:{{ patrol.ref }}">
                <td><span class="mono patrol-ref">{{ patrol.ref }}</span></td>
                <td>{{ ui.type_chip(patrol.type, types, typeColor) }}</td>
                <td>{{ patrol.station ?: '—' }}</td>
                <td>{{ ui.lead_name(patrol.lead) }}</td>
                <td data-patrol-start>{{ ui.started(patrol) }}</td>
                <td class="num">{{ ui.duration(patrol) }}</td>
                {# The design's "NOT COUNTED" under a discarded patrol's distance.
                   Said HERE, where the number is, because the number is the
                   thing that would otherwise be read into a total — the row
                   states what it does not contribute rather than hiding what it
                   measured. #}
                <td class="num">{{ ui.distance(patrol) }}{% if patrol.discarded %}<em class="patrol-rowsub">not counted</em>{% endif %}</td>
                <td>
                    {% if patrol.observations|length %}
                        <span class="chip warn">{{ patrol.observations|length }} obs</span>
                    {% else %}
                        <span class="chip idle">—</span>
                    {% endif %}
                    {% if patrol.discarded %}<em class="patrol-rowsub">kept · viewable</em>{% endif %}
                </td>
                <td>
                    {% if patrol.discarded %}
                        {% if patrol.held %}
                            <span class="chip warn">held for review</span>
                            <em class="patrol-rowsub">discarded · purge stopped</em>
                        {% else %}
                            <span class="chip patrol-discard-pill">discarded</span>
                            <em class="patrol-rowsub">
                                {%- if patrol.discardReason %}{{ patrol.discardReason }}{% endif -%}
                                {%- if patrol.discardReason and patrol.discardedAt %} · {% endif -%}
                                {%- if patrol.discardedAt %}{% set _removedAt = patrol.discardedAt|date_modify('+' ~ retentionDays ~ ' days') %}removed <time datetime="{{ _removedAt|date('c') }}" data-localtime-format="date">{{ _removedAt|date('j M')|lower }}</time>{% endif -%}
                            </em>
                        {% endif %}
                    {% endif %}
                </td>
                <td class="patrol-right"><a class="open-btn" href="{{ path('patrol_show', {uuid: area.uuid, patrol: patrol.uuid}) }}">Open →</a></td>
            </tr>
        {% else %}
            <tr><td colspan="10">{{ filter.isNarrowed ? 'No patrols match this filter.' : 'No patrols recorded yet.' }}</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>