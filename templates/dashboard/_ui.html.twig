{# Bits the widget partials share. The dashboard and the widget library render
   the SAME partials, and the partials render these macros, so a change to a
   chip, a date or the map viewer lands on both screens at once — there is no
   second copy to keep in step.

   Every binding comes from PatrolDashboard (src/Model/PatrolDashboard.php); the
   patrol type vocabulary comes from the deployment's patrol.types config, never
   from code, and the per-type colour from PatrolDashboardService::typeColors()
   so PHP and Twig cannot disagree about it. #}

{# Macros here call each other through `_self`, not through an import: a
   top-level {% import %} only runs when a template is RENDERED, and this one
   never is — the partials import its macros instead. #}

{# The one fallback hex in the templates: a patrol whose type the deployment has
   since dropped still gets drawn. Mirrors PatrolDashboardService::TRACK_COLORS[0]. #}
{% macro color(typeColor, key) %}{{ typeColor[key]|default('#3ED9A8') }}{% endmacro %}

{% macro type_chip(key, types, typeColor) %}
    <span class="chip patrol-tchip" style="--patrol-track: {{ _self.color(typeColor, key) }}">{{ types[key].label|default(key)|lower }}</span>
{% endmacro %}

{# Explicit, lowercase, like the design's tables: "sat 22 aug · 06:10". The
   stored instant is UTC and the text is the no-JS fallback; the `<time
   datetime>` lets the shell's frame-level `localtime` scanner rewrite it to the
   reader's own zone. No controller is named here — portable to any shell host. #}
{% macro started(patrol) %}
    {%- if patrol.startedAt -%}
        <time datetime="{{ patrol.startedAt|date('c') }}">{{ patrol.startedAt|date('D j M')|lower }} · {{ patrol.startedAt|date('H:i') }}</time>
    {%- else -%}—{%- endif -%}
{% endmacro %}

{% macro duration(patrol) %}
    {%- if patrol.startedAt and patrol.endedAt -%}
        {%- set mins = ((patrol.endedAt.timestamp - patrol.startedAt.timestamp) / 60)|round(0, 'floor') -%}
        {{ (mins // 60) }} h {{ '%02d'|format(mins % 60) }}
    {%- else -%}—{%- endif -%}
{% endmacro %}

{% macro distance(patrol) %}
    {%- if patrol.distanceKm is not null -%}{{ patrol.distanceKm|number_format(1) }} km{%- else -%}—{%- endif -%}
{% endmacro %}

{% macro lead_name(user) %}
    {%- if user -%}{{ user.firstName|first }}. {{ user.lastName }}{%- else -%}—{%- endif -%}
{% endmacro %}

{% macro initials(user) %}
    {%- if user -%}{{ user.firstName|first }}{{ user.lastName|first }}{%- else -%}··{%- endif -%}
{% endmacro %}

{# One filter row drives the map, the log AND the charts (the design's own
   caption). It carries FOUR filters, and they split into two kinds on purpose:

    - TYPE, STATION and ZONE filter CLIENT-SIDE: each publishes a `patrol:filter`
      document event, and every coverage map and patrol list on the page answers
      it live, with no reload — patrol's deliberate real-time filtering. Every
      chip row on the page re-marks itself from the same event, so the row above
      the map and the row above the log always agree.

          patrol:filter {type, station, zone}

    - MONTH filters SERVER-SIDE: it is a different QUESTION, not a different way of
      looking at one answer, so each option is a real link that re-queries the
      whole dashboard for that month (?month=YYYY-MM). This is the incidents
      "one filter drives everything" idiom — the map, the log and the charts are
      all scoped to the chosen month, and the type/station/zone chips then filter
      within it.

   The type pills stay quick toggles (the design draws them so); station, zone and
   month are dropdowns in the incidents bar's shared chrome (.i-dd*), one open at a
   time, closed on an outside click or Escape by the filters controller. #}
{% macro filters(dashboard, types, typeColor, now, area, month) %}
    {% set month = month|default(now) %}
    <div class="patrol-chiprow" {{ stimulus_controller('@uhifadhi/patrol-module/filters') }}>
        {# TYPE TOGGLES — quick chips, not a dropdown: the design draws them so, and
           the type is the one filter you flick between without opening anything. #}
        <button type="button" class="mchip on" data-patrol-type="all" aria-pressed="true"
                {{ stimulus_target('@uhifadhi/patrol-module/filters', 'chip') }}
                {{ stimulus_action('@uhifadhi/patrol-module/filters', 'choose') }}>all · {{ dashboard.totalCount }}</button>
        {% for key, type in types %}
            {# The pill wears the colour of the tracks it filters — the one
               typeColors() map, never a second palette (the map-legend rule). #}
            <button type="button" class="mchip patrol-tfilter" data-patrol-type="{{ key }}" aria-pressed="false"
                    style="--patrol-track: {{ _self.color(typeColor, key) }}"
                    {{ stimulus_target('@uhifadhi/patrol-module/filters', 'chip') }}
                    {{ stimulus_action('@uhifadhi/patrol-module/filters', 'choose') }}><i></i>{{ type.label|lower }} · {{ dashboard.typeCounts[key]|default(0) }}</button>
        {% endfor %}

        <span class="sep"></span>

        {# STATION — a DROPDOWN in the incidents bar's chrome (.i-dd*, ported into
           patrol.css). Each option publishes the patrol:filter document event, so
           the coverage map and every patrol list re-render together with no
           reload. Open/close (one at a time, Escape, outside-click) is the same
           controller behaviour incidents uses. #}
        <span class="i-dd" data-patrol-dd {{ stimulus_target('@uhifadhi/patrol-module/filters', 'stationMenu') }}>
            <button type="button" class="mchip i-ddt" data-patrol-dd-trigger aria-haspopup="listbox" aria-expanded="false"
                    {{ stimulus_action('@uhifadhi/patrol-module/filters', 'toggle') }}>
                <span {{ stimulus_target('@uhifadhi/patrol-module/filters', 'stationLabel') }}>station</span><span class="i-ddcaret">&#9662;</span>
            </button>
            <div class="i-ddmenu" data-patrol-dd-menu role="listbox" aria-label="Filter by station">
                <span class="i-ddhead">station</span>
                {% if dashboard.stations|length %}
                    <button type="button" class="i-ddopt on" role="option" data-patrol-station="all"
                            {{ stimulus_target('@uhifadhi/patrol-module/filters', 'station') }}
                            {{ stimulus_action('@uhifadhi/patrol-module/filters', 'chooseStation') }}><span class="i-ddopt-l">all stations</span></button>
                    <span class="i-ddsep"></span>
                {% endif %}
                {% for station in dashboard.stations %}
                    <button type="button" class="i-ddopt" role="option" data-patrol-station="{{ station }}"
                            {{ stimulus_target('@uhifadhi/patrol-module/filters', 'station') }}
                            {{ stimulus_action('@uhifadhi/patrol-module/filters', 'chooseStation') }}><span class="i-ddopt-l">{{ station }}</span></button>
                {% else %}
                    <span class="i-ddopt is-empty" role="option"><span class="i-ddopt-l">no stations yet</span></span>
                {% endfor %}
            </div>
        </span>

        {# ZONE — the design's zone dropdown, now real: a patrol carries no zone
           field, so each patrol's zone is computed by a live PostGIS spatial join
           (PatrolRepository::zonesForPatrols — the zone its track set out in) and
           the menu lists the zones this month's patrols fall in. Filters
           client-side exactly like the station menu, publishing patrol:filter. #}
        <span class="i-dd" data-patrol-dd {{ stimulus_target('@uhifadhi/patrol-module/filters', 'zoneMenu') }}>
            <button type="button" class="mchip i-ddt" data-patrol-dd-trigger aria-haspopup="listbox" aria-expanded="false"
                    {{ stimulus_action('@uhifadhi/patrol-module/filters', 'toggle') }}>
                <span {{ stimulus_target('@uhifadhi/patrol-module/filters', 'zoneLabel') }}>zone</span><span class="i-ddcaret">&#9662;</span>
            </button>
            <div class="i-ddmenu" data-patrol-dd-menu role="listbox" aria-label="Filter by zone">
                <span class="i-ddhead">zone</span>
                {% if dashboard.zones|length %}
                    <button type="button" class="i-ddopt on" role="option" data-patrol-zone="all"
                            {{ stimulus_target('@uhifadhi/patrol-module/filters', 'zone') }}
                            {{ stimulus_action('@uhifadhi/patrol-module/filters', 'chooseZone') }}><span class="i-ddopt-l">all zones</span></button>
                    <span class="i-ddsep"></span>
                {% endif %}
                {% for zone in dashboard.zones %}
                    <button type="button" class="i-ddopt" role="option" data-patrol-zone="{{ zone }}"
                            {{ stimulus_target('@uhifadhi/patrol-module/filters', 'zone') }}
                            {{ stimulus_action('@uhifadhi/patrol-module/filters', 'chooseZone') }}><span class="i-ddopt-l">{{ zone }}</span></button>
                {% else %}
                    <span class="i-ddopt is-empty" role="option"><span class="i-ddopt-l">no zones yet</span></span>
                {% endfor %}
            </div>
        </span>

        {# MONTH — a real dropdown now, not a dead indicator: this month and the
           five before it, each a link that re-queries the whole dashboard for that
           month (?month=YYYY-MM), so the map, log and charts move together. The
           days are anchored to the first of the month before subtracting, so an
           overflowing day-of-month never skips a month. A host that never mounted
           the dashboard route (no `area`) falls back to the plain label. #}
        {% if area is defined and area %}
            <span class="i-dd patrol-dd-chosen" data-patrol-dd>
                <button type="button" class="mchip i-ddt" data-patrol-dd-trigger aria-haspopup="listbox" aria-expanded="false"
                        {{ stimulus_action('@uhifadhi/patrol-module/filters', 'toggle') }}>
                    <span>{{ month|date('F Y')|lower }}</span><span class="i-ddcaret">&#9662;</span>
                </button>
                <div class="i-ddmenu" data-patrol-dd-menu role="listbox" aria-label="Choose month">
                    <span class="i-ddhead">month</span>
                    {% set anchor = now|date_modify('first day of this month') %}
                    {% for i in 0..5 %}
                        {% set m = anchor|date_modify('-' ~ i ~ ' months') %}
                        {% set mKey = m|date('Y-m') %}
                        <a class="i-ddopt{{ month|date('Y-m') == mKey ? ' on' }}" role="option"
                           href="{{ path('patrol_dashboard', {uuid: area.uuid, month: mKey}) }}"><span class="i-ddopt-l">{{ m|date('F Y')|lower }}</span></a>
                    {% endfor %}
                </div>
            </span>
        {% else %}
            <span class="mchip patrol-monthchip">{{ month|date('F Y')|lower }}</span>
        {% endif %}
    </div>
{% endmacro %}
