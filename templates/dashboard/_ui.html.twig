{# Bits the widget partials share. The dashboard and the widget library render
   the SAME partials, and the partials render these macros, so a change to a
   chip, a date or the map viewer lands on both screens at once — there is no
   second copy to keep in step.

   Every binding comes from PatrolDashboard (src/Model/PatrolDashboard.php); the
   patrol type vocabulary comes from the deployment's patrol.types config, never
   from code, and which CATEGORY each type is from
   PatrolDashboardService::typePositions(), so PHP and Twig cannot disagree
   about it. This module names a position and never a colour: the shell
   resolves `data-cat` to a hue, in the page and again on imagery. #}

{# Macros here call each other through `_self`, not through an import: a
   top-level {% import %} only runs when a template is RENDERED, and this one
   never is — the partials import its macros instead. #}

{# A patrol type's CATEGORY, 1 to 9. A type the deployment has since dropped is
   in none of them, and `[data-cat]` with no number is the shell's own "not one
   of the set" — drawn in the muted ink rather than in a colour invented here. #}
{% macro cat(typeCat, key) %}{{ typeCat[key]|default('') }}{% endmacro %}

{% macro type_chip(key, types, typeCat) %}
    <span class="chip patrol-tchip" data-cat="{{ _self.cat(typeCat, key) }}">{{ types[key].label|default(key)|lower }}</span>
{% endmacro %}

{# Explicit, lowercase, like the design's tables: "sat 22 aug · 06:10". The
   stored instant is UTC and the text is the no-JS fallback; the `<time
   datetime>` lets the shell's frame-level `localtime` scanner rewrite it to the
   reader's own zone. No controller is named here — portable to any shell host. #}
{% macro started(patrol) %}
    {%- if patrol.startedAt -%}
        <time datetime="{{ patrol.startedAt|date('c') }}">{{ patrol.startedAt|date('D j M')|lower }} · {{ patrol.startedAt|date('H:i') }}</time>
    {%- else -%}—{%- endif -%}
{% endmacro %}

{% macro duration(patrol) %}
    {%- if patrol.startedAt and patrol.endedAt -%}
        {%- set mins = ((patrol.endedAt.timestamp - patrol.startedAt.timestamp) / 60)|round(0, 'floor') -%}
        {{ (mins // 60) }} h {{ '%02d'|format(mins % 60) }}
    {%- else -%}—{%- endif -%}
{% endmacro %}

{% macro distance(patrol) %}
    {%- if patrol.distanceKm is not null -%}{{ patrol.distanceKm|number_format(1) }} km{%- else -%}—{%- endif -%}
{% endmacro %}

{% macro lead_name(user) %}
    {%- if user -%}{{ user.firstName|first }}. {{ user.lastName }}{%- else -%}—{%- endif -%}
{% endmacro %}

{% macro initials(user) %}
    {%- if user -%}{{ user.firstName|first }}{{ user.lastName|first }}{%- else -%}··{%- endif -%}
{% endmacro %}

{# ONE FILTER ROW DRIVES THE MAP, THE LOG AND THE CHARTS — and it is the SAME
   row the full log wears, drawn once in @UhifadhiPatrol/_filters.html.twig. Two
   copies of a filter row is two answers to "what is on screen".

   THE DASHBOARD CARRIES NO SEARCH BOX. Searching is what the full log is for;
   a card capped at its latest rows would answer a search with the rows it had
   room for, which is worse than not offering one. #}
{% macro filters(dashboard, types, typeCat, now, area, filter) %}
    {% import '@UhifadhiPatrol/_filters.html.twig' as row %}
    {{ row.row('patrol_dashboard', area, filter, types, typeCat, now, {
        allCount: dashboard.totalCount,
        typeCounts: dashboard.typeCounts,
        stations: dashboard.stations,
        stationCounts: {},
        zones: dashboard.zones,
        zoneCounts: {},
    }, null) }}
{% endmacro %}
