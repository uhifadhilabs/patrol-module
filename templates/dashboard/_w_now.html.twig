{# Widget "now" — Out right now (PL·13), off by default; the "Live coverage" and
   "Shift handover" directions turn it on.

   THE ONLY POLLING WIDGET ON THE SURFACE. It reads the SAME live measurement the
   area overview's PL·A1 draws (PatrolOverviewService::out), handed in as `out`
   and `handsets`, so the dashboard and /areas/{uuid} can never disagree about who
   is out this morning. An open patrol has no duration and no distance total yet —
   those fields are ABSENT here, not zero. #}
{% import '@UhifadhiPatrol/dashboard/_ui.html.twig' as ui %}
{% set stalePingMinutes = constant('Uhifadhi\\Patrol\\Service\\PatrolOverviewService::PING_STALE_AFTER_SECONDS') // 60 %}
<div class="c">
    <span class="tab">Out right now<span class="src">· live · {{ out|length }} open {{ out|length == 1 ? 'patrol' : 'patrols' }}</span></span>
    <div class="use patrol-ao-lead">Open patrols are <b>not</b> in this month’s count — a patrol counts when it is closed. A position ping older than {{ stalePingMinutes }} minutes is called out rather than quietly averaged away.</div>

    {% for row in out %}
        <div class="patrol-feed-row patrol-ao-row">
            <span class="patrol-avatar">{{ ui.initials(row.patrol.lead) }}</span>
            <span class="patrol-who">{{ row.patrol.ref }}<em>{{ row.patrol.station ?: '—' }} · {{ ui.lead_name(row.patrol.lead) }}</em></span>
            {{ ui.type_chip(row.patrol.type, types, typeColor) }}
            <span class="patrol-n">{% if row.patrol.startedAt %}opened <time datetime="{{ row.patrol.startedAt|date('c') }}" data-localtime-format="time">{{ row.patrol.startedAt|date('H:i') }}</time>{% else %}opened at an unrecorded time{% endif %}{% if row.outLabel %} · out {{ row.outLabel }}{% endif %}</span>
            {# The ping, in the module's own words. A patrol that has never pinged
               says so — it is not "0 min ago". #}
            {% if row.pingLabel is null %}
                <span class="chip {{ row.stale ? 'fail' : 'idle' }}">no ping yet</span>
            {% else %}
                <span class="chip {{ row.stale ? 'fail' : 'ok' }}">{{ row.stale ? 'no ping for ' ~ row.pingLabel : 'ping ' ~ row.pingLabel ~ ' ago' }}</span>
            {% endif %}
            <span class="patrol-spacer"></span>
            <a class="open-btn" href="{{ row.url }}">Open →</a>
        </div>
    {% else %}
        <p class="patrol-empty">No patrol is out right now.</p>
    {% endfor %}

    {# A handset reporting IS a patrol pinging: the module registers no devices,
       so this is counted over the patrols that are out rather than over a fleet
       it does not have. The one named is the longest-silent — the one to call. #}
    {% if handsets.total %}
        <div class="rln patrol-ao-foot">
            <span class="fog">Handsets reporting</span>
            <span class="mono patrol-ao-mono">{{ handsets.reporting }} of {{ handsets.total }}{% if handsets.worst %} · {{ handsets.worst.patrol.station ?: handsets.worst.patrol.ref }} {% if handsets.worst.lastPingAt %}last seen <time datetime="{{ handsets.worst.lastPingAt|date('c') }}" data-localtime-format="time">{{ handsets.worst.lastPingAt|date('H:i') }}</time>{% else %}has not reported at all{% endif %}{% endif %}</span>
        </div>
    {% endif %}
</div>
