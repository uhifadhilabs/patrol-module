{# The patrol calendar as a FULL PAGE — what a direct visit to patrol_calendar
   lands on.

   patrol_calendar serves TWO shapes on one address: the widget's ‹ › controls
   fetch the bare month fragment (_cal_body) over XHR and swap it in, while a
   plain browser navigation to the same URL gets THIS page — that same calendar
   card wearing the shell frame, the breadcrumb, the page head and, crucially,
   the module's stylesheets (patrol.css, the map chrome, the widget grid). Before
   this, a hard-refresh of the URL rendered the fragment on its own: raw markup,
   no frame and no CSS, because a fragment carries neither.

   The card here is the SAME card the dashboard renders inline (_w_cal) around the
   SAME partial (_cal_body), so the three cannot drift — and the ‹ › nav on this
   page fetches the fragment exactly as it does on the dashboard. #}
{% extends '@UhifadhiPatrol/base.html.twig' %}

{% block title %}Patrols · calendar{% endblock %}

{% block patrol_trail_tail %} <a href="{{ path('patrol_dashboard', {uuid: area.uuid}) }}">patrols</a> / calendar{% endblock %}

{% block shell_page_title %}{{ area.name }} — Patrols · calendar{% endblock %}

{% block shell_page_subtitle %}The month as a calendar — one mark per patrol, and a busy day folded into a “+N more”.{% endblock %}

{% block shell_page_actions %}
{% endblock %}

{% block patrol_page %}
<a class="backbtn" href="{{ path('patrol_dashboard', {uuid: area.uuid}) }}">{{ ux_icon('shell:chevron-left') }}All patrols</a>

{# The calendar card — identical to the dashboard widget (_w_cal): the Stimulus
   controller wires ‹ ›, and the body is the month fragment for the month asked
   for, so month navigation works on this page too. #}
<div class="c" data-patrol-calendar
     {{ stimulus_controller('@uhifadhi/patrol-module/calendar', {url: path('patrol_calendar', {uuid: area.uuid})}) }}>
    <span class="tab">Patrol calendar<span class="src">&middot; <span
                {{ stimulus_target('@uhifadhi/patrol-module/calendar', 'label') }}>{{ month|date('F Y')|lower }}</span></span></span>
    <div {{ stimulus_target('@uhifadhi/patrol-module/calendar', 'body') }}>
        {{ include('@UhifadhiPatrol/dashboard/_cal_body.html.twig', {cells: cells, month: month}) }}
    </div>
</div>
{% endblock %}
