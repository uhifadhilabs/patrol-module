{# THE STATIONS SECTION OF THE CONFIGURE PAGE — body only.

   NO HEAD, NO STRIP, NO CRUMB, NO WAY BACK. The shell draws all four; this file
   writes the section's content and nothing around it.

   ONE SECTION, ONE POST, and a row's own decisions each their own — exactly as
   the Patrol types section beside it, and for the same reasons.
   → POST …/configure/stations (patrol_stations_save)
   @see https://html.spec.whatwg.org/multipage/form-control-infrastructure.html#attr-fae-form #}

{% set save = patrol_url('patrol_stations_save', {uuid: area.uuid}) %}

<div class="tx-say">{{ ux_icon('patrol:shield', {width: 17, height: 17}) }}<div><b>These stations are {{ area.name }}&rsquo;s own.</b>
    Each area keeps its own, so a station added here reaches only the handsets patrolling {{ area.name }}.
    Editing rides on <span class="mono">patrols.manage</span> — the authority over the words everybody else must
    use. Being able to log a patrol (<span class="mono">patrols.record</span>) is not enough.</div></div>

{% if save %}<form method="post" action="{{ save }}">
<input type="hidden" name="_token" value="{{ csrfToken }}">{% endif %}
<div class="c" style="margin-bottom:20px">
    <span class="tab">Stations<span class="src">· where a patrol sets off</span></span>
    {# Never deleted: a patrol filed against a station keeps it. Retiring takes it
       off the handset at the next sync and leaves every record intact. #}
    {% for station in stations %}
        {% set n = stationCounts[station.key]|default(0) %}
        <div class="srow{{ station.active ? '' : ' gone' }}">
            <span class="nm">{{ station.label }}</span>
            <span class="cd">{{ station.key }}</span>
            {% if not station.active %}<span class="chip idle">retired</span>{% endif %}
            <span class="n">{{ n }} {{ n == 1 ? 'patrol' : 'patrols' }}</span>
            {% if save %}
                <span class="acts">
                    <details>
                        <summary class="sact">Rename</summary>
                        <input class="fld" style="width:150px" type="text" name="label" value="{{ station.label }}"
                               form="patrol-station-rename-{{ station.uuid }}" aria-label="Rename {{ station.label }}" required>
                        <button class="sact" type="submit" form="patrol-station-rename-{{ station.uuid }}">Save</button>
                    </details>
                    {% if station.active %}
                        <button class="sact warn" type="submit" form="patrol-station-retire-{{ station.uuid }}">Retire</button>
                    {% else %}
                        <button class="sact" type="submit" form="patrol-station-reactivate-{{ station.uuid }}">Reactivate</button>
                    {% endif %}
                </span>
            {% endif %}
        </div>
    {% else %}
        <div class="srow"><span class="nm">This area keeps no stations yet.</span></div>
    {% endfor %}

    {% if save %}
        <div class="saddcard">
            <span class="hd">Add a station</span>
            <div class="saddrow">
                <input class="fld" type="text" name="label" placeholder="Name of the new station" aria-label="New station">
                <button class="sadd" type="submit">+ Add station</button>
            </div>
        </div>
    {% endif %}
</div>

{% if save %}
    <div class="save-row"><button class="cta" type="submit">Save stations</button></div>
</form>

    {% for station in stations %}
        {% for action in ['rename', 'retire', 'reactivate'] %}
            <form id="patrol-station-{{ action }}-{{ station.uuid }}" method="post"
                  action="{{ patrol_url('patrol_station_act', {uuid: area.uuid, station: station.uuid, action: action}) }}">
                <input type="hidden" name="_token" value="{{ csrfToken }}">
            </form>
        {% endfor %}
    {% endfor %}
{% endif %}
