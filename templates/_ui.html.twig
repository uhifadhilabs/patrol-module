{# Bits the two detail screens share (settled designs "detail" and
   "observation"): the plate viewer chrome, the design's explicit lowercase
   dates and the per-type track colour. The dashboard keeps its own copies —
   this file exists for the detail genre, and the two screens must never drift
   apart from each other. #}

{% macro type_label(key, types) %}{{ types[key].label|default(key)|lower }}{% endmacro %}

{% macro category_label(key, categories) %}{{ categories[key].label|default(key)|lower }}{% endmacro %}

{# Explicit and lowercase, like the design's meta rows: "sat 22 aug · 06:10".

   A stored instant is UTC; the visible text here is the readable no-JS fallback.
   The `<time datetime>` carries the machine instant, and the shell's frame-level
   `localtime` scanner (mounted on the <body> it owns) rewrites the text to the
   READER's own zone in the browser. The element names no controller, so this
   template stays portable to any host that renders through the shell — see the
   shell's docs/theming.md, "A time reads in the reader's zone". #}
{% macro stamp(value) %}
    {%- if value -%}<time datetime="{{ value|date('c') }}">{{ value|date('D j M')|lower }} · {{ value|date('H:i') }}</time>{%- else -%}—{%- endif -%}
{% endmacro %}

{# The history rows read the other way round: "12:41 · 22 aug". Same UTC-stored,
   viewer-localised contract as stamp() above. #}
{% macro log_stamp(value) %}
    {%- if value -%}<time datetime="{{ value|date('c') }}">{{ value|date('H:i') }} · {{ value|date('j M')|lower }}</time>{%- else -%}—{%- endif -%}
{% endmacro %}

{% macro duration(patrol) %}
    {%- if patrol.startedAt and patrol.endedAt -%}
        {%- set mins = ((patrol.endedAt.timestamp - patrol.startedAt.timestamp) / 60)|round(0, 'floor') -%}
        {{ (mins // 60) }} h {{ '%02d'|format(mins % 60) }}
    {%- else -%}—{%- endif -%}
{% endmacro %}

{% macro distance(patrol) %}
    {%- if patrol.distanceKm is not null -%}{{ patrol.distanceKm|number_format(1) }} km{%- else -%}—{%- endif -%}
{% endmacro %}

{% macro person_name(user) %}
    {%- if user -%}{{ user.firstName|first }}. {{ user.lastName }}{%- else -%}—{%- endif -%}
{% endmacro %}

{# THE DETAIL PLATE. The map is the atlas's — stated in PHP (Service/PatrolMapService)
   and rendered by render_map() — so the imagery, the boundary treatment, the
   control stack, the legend and fullscreen are the platform's and this module
   writes no map JavaScript.

   The two captions the design puts on the imagery ride in the plate's filter
   slot instead: one row above the map, inside the plate, so they come along
   into fullscreen. #}
{% macro plate(map, label, olId, olSrc) %}
    {% set caption %}
        <span class="patrol-cap patrol-cap-id">{{ olId }}</span>
        <span class="patrol-cap">{{ olSrc }}</span>
    {% endset %}
    {{ render_map(map, {'role': 'img', 'aria-label': label}, caption) }}
{% endmacro %}

{# ── the recording screens' shared fields ───────────────────────────────────
   Both settled designs ("import" and "log") open their details card with the
   same three rows — type, station, lead — so they live here once and can never
   drift apart. Everything is native HTML: a reusable bundle must not require a
   Stimulus controller to be installed before a patrol can be recorded. #}

{# The design's type chips, as a radio group: one is always chosen, keyboard
   reachable, and submitted without a line of JavaScript (patrol.css styles the
   checked chip through :has()). The words are THIS AREA's own patrol types,
   the ones SET·01 renames and retires; a retired one is not offered. #}
{% macro type_chips(types, selected) %}
    <div class="patrol-chipset">
        {% for type in types %}
            <label class="mchip patrol-chip-radio">
                <input type="radio" name="type" value="{{ type.key }}"{{ (selected ?: types|first.key) == type.key ? ' checked' : '' }}>{{ type.label|lower }}
            </label>
        {% endfor %}
    </div>
{% endmacro %}

{# The design's station chips, as a radio group over this area's live stations —
   the same control as the types, because a station is the same kind of thing.
   "—" is first and is a real answer — plenty of patrols set off from nowhere in
   particular. #}
{% macro station_chips(stations, selected) %}
    <div class="patrol-chipset">
        <label class="mchip patrol-chip-radio">
            <input type="radio" name="station" value=""{{ selected ? '' : ' checked' }}>—
        </label>
        {% for station in stations %}
            <label class="mchip patrol-chip-radio">
                <input type="radio" name="station" value="{{ station.key }}"{{ selected == station.key ? ' checked' : '' }}>{{ station.label|lower }}
            </label>
        {% endfor %}
    </div>
{% endmacro %}

{# The design draws a text input here, but lead is a User relation on the
   patrol (the detail screen prints "A. Alpha" from it), so a free-text name
   would be unstorable. A select of the deployment's people is the faithful
   control for that binding; "—" records no lead at all. #}
{% macro lead_select(users, selected) %}
    <select class="fld" name="lead">
        <option value="">—</option>
        {% for user in users %}
            <option value="{{ user.id }}"{{ selected == user.id ? ' selected' : '' }}>{{ user.firstName }} {{ user.lastName }}</option>
        {% endfor %}
    </select>
{% endmacro %}
