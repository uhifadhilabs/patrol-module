{# Bundle base: the host's shell plus patrol's own stylesheet. Every patrol page
   extends this instead of the host layout directly, so the widget-dashboard
   additions load only where the module renders — the host's own stylesheet
   never references patrol. #}
{% extends 'layout.html.twig' %}

{# Symfony docs — https://symfony.com/doc/current/frontend/asset_mapper.html :
   "All bundles that have a Resources/public/ or public/ directory will
   automatically have that directory added as an asset path, using the namespace:
   bundles/<BundleName>" — and under AssetMapper those assets are automatically
   content-versioned. So public/patrol.css is served as
   bundles/uhifadhilabspatrol/patrol.css with a digest, no assets:install. #}
{% block stylesheets %}
    {{ parent() }}
    {# Leaflet FIRST, so patrol.css can restyle its controls into the design's
       pills. Both files are the host's own self-hosted copy (assets/leaflet/) —
       never a CDN, and the same Leaflet the host's area map runs on, so a patrol
       map and an area map cannot disagree about how a layer draws. A host of
       this module ships those two assets; that is part of the seam, like the
       host's AreaOfInterest the bundle already binds to. #}
    <link rel="stylesheet" href="{{ asset('leaflet/leaflet.css') }}">
    <link rel="stylesheet" href="{{ asset('bundles/uhifadhilabspatrol/patrol.css') }}">
{% endblock %}

{# Leaflet is a classic script exposing `window.L`, which is what the map
   controllers read. A classic <script> in <head> runs before the deferred
   importmap modules, so `window.L` is there by the time a controller connects.
   MapLibre is deliberately NOT used — see the host's map_controller.js: raster
   tiles + GeoJSON need no WebGL, and WebGL failed silently (blank map) in
   constrained environments. #}
{% block javascripts %}
    <script src="{{ asset('leaflet/leaflet.js') }}"></script>
    {{ parent() }}
{% endblock %}

{# The host layout expects each page to supply its own `.page` container (the
   max-width + side padding wrapper the built-in pages use). Provide it once here
   so every patrol page inherits the same margins; pages fill `patrol_page`. #}
{% block content %}
    <div class="page">
        {# Flashes render the way the host's own pages render them (a .c card
           with the accent tick, above the page content) — a saved patrol must
           read the same whichever screen the user came from. The style lives in
           patrol.css rather than inline, unlike the host's copy. #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="c patrol-flash" data-patrol-flash="{{ label }}"><span class="acc">✓</span> {{ message }}</div>
            {% endfor %}
        {% endfor %}
        {% block patrol_page %}{% endblock %}
    </div>
{% endblock %}