{# ============================================================================
   THE PATROLS WIDGET LIBRARY.

   The PAGE is the chrome — a crumb, a header and its two actions. Everything
   below is templates/widgets/_library.html.twig: the HOST's preset component,
   identical on every surface that ships a WidgetCatalog and parameterised by
   this surface's catalogue, partial name and routes. There are no
   patrol-specific widget mechanics anywhere.

   AREA-SCOPED: every URL the component is handed names this area, so arranging
   one area's patrols dashboard leaves every other area's alone.
   ========================================================================== #}
{% extends '@UhifadhiPatrol/base.html.twig' %}

{# A PAGE SAYS ONLY WHAT IT IS. The shell's document composes the tab title as
   page — place — brand, so naming the area here would print it twice. #}
{% block title %}Patrols · widget library{% endblock %}

{% block patrol_trail_tail %} <a href="{{ path('patrol_dashboard', {uuid: area.uuid}) }}">patrols</a> / widgets{% endblock %}

{% block shell_page_title %}{{ area.name }} — Patrols · configure{% endblock %}

{% block shell_page_subtitle %}Everything this module is set up with in <b>this area</b>, in one place: how its dashboard is composed, the words a ranger picks from, and the numbers the module runs on.{% endblock %}

{% block shell_page_actions %}
    {# Throwing the whole composition away asks first — through the host's
       reusable confirm-modal controller, never the browser's own dialog. #}
    <button type="button" class="tgl patrol-act" {{ constant('Uhifadhi\\Bundle\\ShellBundle\\Widget\\Model\\WidgetDom::RESET') }}
            {{ stimulus_controller('confirm-modal') }}
            data-action="click->confirm-modal#ask"
            data-confirm-modal-title-value="Reset your widget layout?"
            data-confirm-modal-message-value="This area's patrols dashboard goes back to the composition the module ships with. Your own presets are kept, and your other areas are untouched."
            data-confirm-modal-confirm-label-value="Reset layout"
            data-confirm-modal-danger-value="true">{{ ux_icon('shell:rotate-ccw') }}Reset to defaults</button>
{% endblock %}

{# NO SCRIPT TAG HERE, and that is deliberate rather than an omission. The page
   renders server-side and every action on it is a plain form post, so it is
   whole without JavaScript; what the script adds is PREVIEW and the picker's
   live filtering. It lives in ShellBundle under the AssetMapper namespace
   `@uhifadhi/shell-bundle`, and naming that namespace belongs to importmap.php
   — the one file a bundle may not write. An installation that wants the
   enhancement adds it once, for every surface at once:

     // assets/app.js
     import '@uhifadhi/shell-bundle/widgets';

   The module arms itself on import, so there is no call to write. A hard
   `import` typed here instead would be this module deciding an installation's
   importmap on its behalf, and would take the whole page down wherever that
   entry is absent. #}
{% block patrol_page %}
{{ include('@Shell/widget/_library.html.twig', {
    catalog: catalog,
    builtins: builtins,
    customPresets: customPresets,
    active: active,
    widgets: widgets,
    partial: partial,
    widgetContext: widgetContext,
    urls: urls,
    csrfToken: csrfToken,
}, with_context: false) }}
{% endblock %}