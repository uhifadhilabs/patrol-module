{
    "name": "uhifadhi/patrol-module",
    "description": "Patrols: field patrol effort as first-class records — GPX track ingest, en-route observations with photos, coverage mapping and a per-user widget dashboard.",
    "type": "symfony-bundle",
    "keywords": [
        "symfony-ux",
        "patrol",
        "ranger",
        "tracking",
        "gpx",
        "gis",
        "postgis",
        "symfony",
        "uhifadhi"
    ],
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Ezekiel Mjema",
            "homepage": "https://github.com/eemjema"
        }
    ],
    "require": {
        "doctrine/dbal": "^4.0",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/orm": "^3.5",
        "ext-simplexml": "*",
        "ext-xmlwriter": "*",
        "fundistadi/postgis-bundle": "^0.5",
        "php": ">=8.4",
        "symfony/asset": "^7.3 || ^8.0",
        "symfony/asset-mapper": "^7.3 || ^8.0",
        "symfony/config": "^7.3 || ^8.0",
        "symfony/console": "^7.3 || ^8.0",
        "symfony/framework-bundle": "^7.3 || ^8.0",
        "symfony/http-foundation": "^7.3 || ^8.0",
        "symfony/mime": "^7.3 || ^8.0",
        "symfony/twig-bundle": "^7.3 || ^8.0",
        "symfony/uid": "^7.3 || ^8.0",
        "symfony/ux-icons": "^3.4",
        "uhifadhi/area-module": "^0.2 || ^0.3 || ^0.4 || ^0.5",
        "uhifadhi/map-module": "^0.1",
        "uhifadhi/module-contracts": "^0.3",
        "uhifadhi/storage-module": "^0.2",
        "uhifadhi/widget-module": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "Uhifadhi\\Patrol\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Uhifadhi\\Patrol\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "api-platform/core": "^4.3",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpdocumentor/reflection-docblock": "^6.0",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.2",
        "symfony/browser-kit": "^7.3 || ^8.0",
        "symfony/css-selector": "^7.3 || ^8.0",
        "symfony/dependency-injection": "^7.3 || ^8.0",
        "symfony/property-access": "^7.3 || ^8.0",
        "symfony/property-info": "^7.3 || ^8.0",
        "symfony/security-bundle": "^7.3 || ^8.0",
        "symfony/security-core": "^7.3 || ^8.0",
        "symfony/security-csrf": "^7.3 || ^8.0",
        "symfony/security-http": "^7.3 || ^8.0",
        "symfony/serializer": "^7.3 || ^8.0",
        "symfony/stimulus-bundle": "^2.20 || ^2.30 || ^2.0",
        "symfony/validator": "^7.3 || ^8.0",
        "uhifadhi/seam-module": "^0.1",
        "uhifadhi/shell-module": "^0.6",
        "uhifadhi/team-module": "^0.4"
    },
    "scripts": {
        "cs:fix": "php-cs-fixer fix",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "phpstan": "phpstan analyse --no-progress --memory-limit=1G",
        "test": "phpunit",
        "check": [
            "@cs:check",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.3-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "uhifadhi/shell-module": "The page frame every patrol screen renders in. Without it the screens have no frame to extend and the module is field-sync machinery only.",
        "uhifadhi/seam-module": "The per-area module catalogue this module registers itself in, and the grid an area’s Modules tab draws. Without it the patrol screens are reachable only by their own routes.",
        "api-platform/core": "Required for the field-sync API the handset talks to. Without it the module keeps every screen and loses only /api."
    }
}
